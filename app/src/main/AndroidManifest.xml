<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_*" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />

    <application
        android:name="com.tech.eskool.util.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Default"
        tools:targetApi="31">
        <activity
            android:name="com.tech.eskool.YoutubeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/title_activity_youtube"
            android:theme="@style/Theme.Default.Fullscreen" />
        <activity
            android:name="com.tech.eskool.TeacherDashBoardActivity"
            android:exported="false"
            android:label="@string/title_activity_teacher_dash_board"
            android:theme="@style/Theme.Default" />
        <activity
            android:name="com.tech.eskool.StudentsDashboardActivity"
            android:exported="false"
            android:label="@string/title_activity_students_dashboard"
            android:theme="@style/Theme.Default" />
        <activity
            android:name="com.tech.eskool.ForgetPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Default" />
        <activity
            android:name="com.tech.eskool.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Default"/>
        <activity
            android:name="com.tech.eskool.VerifyActivity"
            android:exported="false"
            android:theme="@style/Theme.Default" />
        <activity
            android:name="com.tech.eskool.LoginTypeActivity"
            android:exported="false"
            android:theme="@style/Theme.Default" />
        <activity
            android:name="com.tech.eskool.StartActivity"
            android:exported="true"
            android:theme="@style/Theme.Default">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.tech.eskool.notification.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/purple_900" />
    </application>

</manifest>