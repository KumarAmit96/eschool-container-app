<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/brand_primary_dark" /> <!-- Background color -->
            <size android:width="48dp" android:height="48dp" /> <!-- Size of the circle -->
        </shape>
    </item>

    <!-- Progress circle -->
    <item>
        <clip>
            <shape android:shape="oval">
                <solid android:color="@color/brand_accent" /> <!-- Progress color -->
                <size android:width="48dp" android:height="48dp" /> <!-- Size of the circle -->
            </shape>
        </clip>
    </item>
</layer-list>