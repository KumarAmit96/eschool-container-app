<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Platform.MaterialComponents.Light">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/purple_900</item>
        <item name="colorError">@color/red</item>
        <item name="actionMenuTextColor">@color/white</item>
        <item name="actionBarTheme">@style/Theme.MaterialComponents.NoActionBar</item>
        <item name="colorBackgroundFloating">@color/white</item>
        <item name="editTextColor">@color/black</item>
        <item name="android:textColor">@color/black</item>
        <item name="actionButtonStyle">@style/myActionButtonStyle</item>
        <item name="android:actionButtonStyle">@style/myActionButtonStyle</item>
        <item name="alertDialogStyle">@style/myAlertDialog</item>
    </style>

    <style name="myEditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_size</item>
        <item name="hintTextAppearance">@style/TextLabel</item>
    </style>
    <!--        <item name="android:colorAccent">@color/purple_500</item>
-->
    <style name="myAlertDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:textColor">@color/black</item>
        <item name="buttonStyle">@style/MyButton</item>
        <item name="colorBackgroundFloating">@color/white</item>
        <item name="android:background">@color/white</item>
        <!--        <item name="android:textSize">@dimen/material_dimen_12_sp</item>-->
        <!--        <item name="android:textStyle">normal</item>-->
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Caption</item>
    </style>

    <style name="TextLabel" parent="TextAppearance.AppCompat">
        <!-- Hint color and label color in FALSE state -->
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/purple_500</item>
        <!-- Label color in TRUE state and bar color FALSE and TRUE State -->
        <item name="colorAccent">@color/purple_500</item>
        <item name="colorControlNormal">@color/purple_700</item>
    </style>

    <style name="myTabLayout" parent="Base.Widget.Design.TabLayout">
        <item name="tabIndicatorFullWidth">false</item>
    </style>

    <style name="Base.Widget.Design.TabLayout" parent="android:Widget" tools:ignore="PrivateResource">
        <item name="android:background">@color/white</item>
        <item name="tabIconTint">@null</item>
        <item name="tabIndicatorAnimationDuration">@integer/design_tab_indicator_anim_duration_ms
        </item>
        <item name="tabIndicatorColor">@color/purple_500</item>
        <item name="tabIndicatorGravity">bottom</item>
        <item name="tabPaddingStart">12dp</item>
        <item name="tabPaddingEnd">12dp</item>
        <item name="tabTextColor">@color/purple_500</item>
        <item name="tabRippleColor">@color/purple_900</item>
        <item name="tabUnboundedRipple">true</item>
    </style>

    <style name="TextAppearance.Design.Tab" parent="TextAppearance.AppCompat.Button" tools:ignore="PrivateResource">
        <item name="android:textSize">@dimen/design_tab_text_size</item>
        <item name="android:textColor">@color/mtrl_tabs_legacy_text_color_selector</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="navigationBar" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.MaterialComponents.TabLayout" parent="Widget.Design.TabLayout">
        <item name="enforceMaterialTheme">true</item>
        <item name="enforceTextAppearance">true</item>
        <item name="android:background">@color/white</item>
        <item name="tabIconTint">@color/purple_500</item>
        <item name="tabTextAppearance">?attr/textAppearanceButton</item>
        <item name="tabTextColor">@color/purple_500</item>
        <item name="tabRippleColor">@color/purple_900</item>
        <item name="tabUnboundedRipple">true</item>
    </style>

    <style name="TabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="enforceMaterialTheme">true</item>
        <item name="enforceTextAppearance">true</item>
        <item name="android:background">@color/white</item>
        <item name="tabIconTint">@color/purple_500</item>
        <item name="tabIndicatorAnimationDuration">@integer/mtrl_tab_indicator_anim_duration_ms
        </item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabTextAppearance">?attr/textAppearanceButton</item>
        <item name="tabTextColor">@color/purple_500</item>
        <item name="tabRippleColor">@color/purple_900</item>
        <item name="tabUnboundedRipple">true</item>
    </style>


    <style name="Widget.MaterialComponents.TabLayout.PrimarySurface" parent="Widget.MaterialComponents.TabLayout.Colored" />


    <style name="MyAppThemeNoAction" parent="Theme.MaterialComponents.Light.NoActionBar">

        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_900</item>
        <item name="colorAccent">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>

    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


    <style name="CalenderViewCustom" parent="Theme.AppCompat">
        <item name="colorAccent">@android:color/holo_blue_dark</item>
        <item name="colorPrimary">@android:color/darker_gray</item>
    </style>

    <style name="CalenderViewDateCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@android:color/holo_orange_dark</item>
    </style>

    <style name="CalenderViewWeekCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@android:color/holo_green_dark</item>
    </style>

    <style name="MyButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/purple_900</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:color">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.SmallComponent</item>
    </style>

    <style name="Widget.Shrine.Backdrop" parent="">
        <item name="android:background">?attr/colorAccent</item>
    </style>

    <style name="MyAlertDialogStyle" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:textColor">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:textSize">@dimen/text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="myActionButtonStyle" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">24dp</item>
        <item name="android:maxWidth">30dp</item>
        <item name="android:width">30dp</item>
        <item name="android:tint">@color/white</item>
        <item name="android:padding">3dp</item>
    </style>


    <style name="MyAlertDialog" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/purple_500</item>
        <item name="colorControlActivated">@color/purple_500</item>
        <item name="colorControlHighlight">@color/purple_900</item>
    </style>

    <style name="DialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="colorAccent">@color/purple_500</item>
    </style>

    <style name="Widget.MaterialComponents.TabLayout.Colored">
        <item name="tabTextAppearance">@style/Widget.AppCompat.Light.ActionBar.TabText</item>
        <item name="android:background">@color/white</item>
        <item name="tabTextColor">@color/purple_500</item>
        <item name="tabIconTint">@color/purple_500</item>
        <item name="tabRippleColor">@color/purple_500</item>
        <item name="tabIndicatorColor">@color/purple_500</item>
    </style>

    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="splashwindow" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Custom Circular ProgressBar Style -->
    <style name="CustomCircularProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/progress_bar
        </item> <!-- Custom drawable -->
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Custom Text Appearance -->
    <style name="CustomMenuTextAppearance">
        <item name="android:textSize">@dimen/margin_14_sp</item> <!-- Set the text size -->
        <item name="android:textColor">#000000</item> <!-- Set the text color -->
        <item name="android:fontFamily">@font/roboto</item>
        <item name="textAllCaps">true</item><!-- Optional: Set font -->
        <item name="paddingStart">@dimen/size_2</item>
    </style>

    <style name="Widget.Theme.Default.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.Theme.Default.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>


</resources>
