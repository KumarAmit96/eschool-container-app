<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".LoginActivity">

    <!-- Doodle background without the big logo, cropped to fill any screen -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/login_bg" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/size_20"
            android:paddingTop="@dimen/size_32"
            android:paddingEnd="@dimen/size_20"
            android:paddingBottom="@dimen/size_32">

            <ImageView
                android:layout_width="@dimen/size_200"
                android:layout_height="@dimen/size_100"
                android:layout_marginBottom="@dimen/size_20"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/school_logo" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="@dimen/size_16"
                app:cardElevation="@dimen/size_6"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/size_20">

                    <TextView
                        android:id="@+id/loginText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="@string/login"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/margin_24_sp" />

                    <TextView
                        android:id="@+id/welcomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_4"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="@string/welcome_back_title"
                        android:textColor="@color/brand_green_dark"
                        android:textSize="@dimen/margin_16_sp" />

                    <TextView
                        android:id="@+id/loginContinueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_medium"
                        android:text="@string/login_to_continue"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/margin_14_sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/collegecode"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_20"
                        android:hint="@string/college_code"
                        app:boxCornerRadiusBottomEnd="@dimen/size_10"
                        app:boxCornerRadiusBottomStart="@dimen/size_10"
                        app:boxCornerRadiusTopEnd="@dimen/size_10"
                        app:boxCornerRadiusTopStart="@dimen/size_10"
                        app:boxStrokeColor="@color/brand_green_dark"
                        app:hintTextColor="@color/brand_green_dark">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/code_college"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:textColor="@color/text_dark" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/username"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_12"
                        android:hint="@string/username"
                        app:boxCornerRadiusBottomEnd="@dimen/size_10"
                        app:boxCornerRadiusBottomStart="@dimen/size_10"
                        app:boxCornerRadiusTopEnd="@dimen/size_10"
                        app:boxCornerRadiusTopStart="@dimen/size_10"
                        app:boxStrokeColor="@color/brand_green_dark"
                        app:hintTextColor="@color/brand_green_dark">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/username_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/text_dark" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_12"
                        android:hint="@string/password"
                        app:boxCornerRadiusBottomEnd="@dimen/size_10"
                        app:boxCornerRadiusBottomStart="@dimen/size_10"
                        app:boxCornerRadiusTopEnd="@dimen/size_10"
                        app:boxCornerRadiusTopStart="@dimen/size_10"
                        app:boxStrokeColor="@color/brand_green_dark"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/brand_green_dark">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/text_dark" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_50"
                        android:layout_marginTop="@dimen/size_24"
                        android:backgroundTint="@color/text_dark"
                        android:fontFamily="@font/quicksand_bold"
                        android:letterSpacing="0.1"
                        android:onClick="callLogin"
                        android:text="@string/submit"
                        android:textColor="@color/white"
                        android:textSize="@dimen/margin_16_sp"
                        app:cornerRadius="@dimen/size_10"
                        app:rippleColor="@color/brand_green" />

                    <LinearLayout
                        android:id="@+id/forgot_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_12"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="@dimen/size_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/quicksand_medium"
                            android:text="@string/forget_password"
                            android:textColor="@color/text_muted"
                            android:textSize="@dimen/margin_14_sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:fontFamily="@font/quicksand_bold"
                            android:onClick="getForgetCall"
                            android:padding="@dimen/size_4"
                            android:text="@string/click_here"
                            android:textColor="@color/brand_green_dark"
                            android:textSize="@dimen/margin_14_sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
