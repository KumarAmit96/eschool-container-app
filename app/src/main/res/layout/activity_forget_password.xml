<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ForgetPasswordActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/login_bg" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_20"
            android:paddingTop="@dimen/size_32"
            android:paddingEnd="@dimen/size_20"
            android:paddingBottom="@dimen/size_32">

        <!-- STEP: old password / OTP + new password (ForgetPasswordActivity toggles visibility) -->
        <RelativeLayout
            android:id="@+id/password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="@dimen/size_16"
                app:cardElevation="@dimen/size_6"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/size_20">

                    <ImageView
                        android:id="@+id/image"
                        android:layout_width="@dimen/size_150"
                        android:layout_height="@dimen/size_80"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/size_16"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/school_logo" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="@string/reset_password"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/margin_22_sp" />

                    <TextView
                        android:id="@+id/message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_4"
                        android:fontFamily="@font/quicksand_medium"
                        android:text="@string/enter_your_new_password_below"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/margin_14_sp" />

                    <LinearLayout
                        android:id="@+id/form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/otp_pass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_20"
                            android:layout_marginBottom="@dimen/size_6"
                            android:fontFamily="@font/quicksand_bold"
                            android:text="@string/old_password"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/margin_14_sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxCornerRadiusBottomEnd="@dimen/size_10"
                            app:boxCornerRadiusBottomStart="@dimen/size_10"
                            app:boxCornerRadiusTopEnd="@dimen/size_10"
                            app:boxCornerRadiusTopStart="@dimen/size_10"
                            app:boxStrokeColor="@color/brand_green_dark"
                            app:hintEnabled="false"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/otp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_enter_here"
                                android:imeOptions="actionNext"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textColor="@color/text_dark"
                                android:textColorHint="@color/text_muted" />

                        </com.google.android.material.textfield.TextInputLayout>
                        <TextView
                            android:id="@+id/new_pass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_16"
                            android:layout_marginBottom="@dimen/size_6"
                            android:fontFamily="@font/quicksand_bold"
                            android:text="@string/new_password"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/margin_14_sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxCornerRadiusBottomEnd="@dimen/size_10"
                            app:boxCornerRadiusBottomStart="@dimen/size_10"
                            app:boxCornerRadiusTopEnd="@dimen/size_10"
                            app:boxCornerRadiusTopStart="@dimen/size_10"
                            app:boxStrokeColor="@color/brand_green_dark"
                            app:hintEnabled="false"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pass_new"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_new_password"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textColor="@color/text_dark"
                                android:textColorHint="@color/text_muted" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_50"
                        android:layout_marginTop="@dimen/size_24"
                        android:backgroundTint="@color/text_dark"
                        android:fontFamily="@font/quicksand_bold"
                        android:letterSpacing="0.1"
                        android:text="@string/submit"
                        android:textColor="@color/white"
                        android:textSize="@dimen/margin_16_sp"
                        app:cornerRadius="@dimen/size_10"
                        app:rippleColor="@color/brand_green" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

        <!-- STEP: enrollment number to receive OTP -->
        <RelativeLayout
            android:id="@+id/enrollment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="@dimen/size_16"
                app:cardElevation="@dimen/size_6"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/size_20">

                    <ImageView
                        android:id="@+id/image_otp"
                        android:layout_width="@dimen/size_150"
                        android:layout_height="@dimen/size_80"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/size_16"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/school_logo" />

                    <TextView
                        android:id="@+id/title_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="@string/reset_password"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/margin_22_sp" />

                    <TextView
                        android:id="@+id/message_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_4"
                        android:fontFamily="@font/quicksand_medium"
                        android:text="@string/enter_your_enrollment"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/margin_14_sp" />

                    <LinearLayout
                        android:id="@+id/form_otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/enroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_20"
                            android:layout_marginBottom="@dimen/size_6"
                            android:fontFamily="@font/quicksand_bold"
                            android:text="@string/enrollment"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/margin_14_sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxCornerRadiusBottomEnd="@dimen/size_10"
                            app:boxCornerRadiusBottomStart="@dimen/size_10"
                            app:boxCornerRadiusTopEnd="@dimen/size_10"
                            app:boxCornerRadiusTopStart="@dimen/size_10"
                            app:boxStrokeColor="@color/brand_green_dark"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/enroll_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_enrollment"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="@color/text_dark"
                                android:textColorHint="@color/text_muted" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/submit_otp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_50"
                        android:layout_marginTop="@dimen/size_24"
                        android:backgroundTint="@color/text_dark"
                        android:fontFamily="@font/quicksand_bold"
                        android:letterSpacing="0.1"
                        android:text="@string/submit"
                        android:textColor="@color/white"
                        android:textSize="@dimen/margin_16_sp"
                        app:cornerRadius="@dimen/size_10"
                        app:rippleColor="@color/brand_green" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

        </FrameLayout>

    </ScrollView>

</FrameLayout>
